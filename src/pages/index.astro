  <!-- ANALYSE / KONTAKT -->
  <section id="analyse" class="bg-paper-2">
    <div class="container-site grid gap-12 py-20 sm:py-28 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="eyebrow">Kostenlose Analyse</p>
        <h2 class="h-display mt-3 text-3xl sm:text-4xl lg:text-5xl">Wo verlierst du gerade Kunden?</h2>
        <p class="mt-5 text-lg text-ink-2">Ich prüfe deine Sichtbarkeit in Google, Google Maps, ChatGPT und Bewertungsportalen. Du bekommst innerhalb von 48 Stunden eine kurze Auswertung mit den drei wichtigsten Hebeln. Kostenlos, ohne Verpflichtung.</p>
        <ul class="check-list mt-8 space-y-3">
          <li>Sichtbarkeits-Score für Google und KI-Suchen</li>
          <li>Vergleich mit drei lokalen Wettbewerbern</li>
          <li>Konkrete nächste Schritte, auch ohne mich</li>
        </ul>
        <div class="mt-10 flex items-center gap-4">
          <img src="/gerrit.jpg" alt="Gerrit Halfmann" width="256" height="256" class="h-12 w-12 rounded-full object-cover" />
          <div class="text-sm">
            <p class="font-semibold">{site.owner}</p>
            <p class="text-ink-3">Designer, Entwickler, SEO. Eine Person, seit {site.ownerSince}.</p>
          </div>
        </div>
      </div>
      <form name="analyse" method="POST" action="/submit.php" class="card p-7 sm:p-9">
                <p class="hidden"><label>Nicht ausfüllen: <input name="website-url" /></label></p>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium">Name
            <input required name="name" type="text" autocomplete="name" class="mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-base outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
          </label>
          <label class="block text-sm font-medium">Unternehmen
            <input required name="unternehmen" type="text" autocomplete="organization" class="mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-base outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
          </label>
          <label class="block text-sm font-medium">Website
            <input name="website" type="url" placeholder="https://" class="mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-base outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
          </label>
          <label class="block text-sm font-medium">Ort
            <input required name="ort" type="text" autocomplete="address-level2" class="mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-base outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
          </label>
          <label class="block text-sm font-medium">E-Mail
            <input required name="email" type="email" autocomplete="email" class="mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-base outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
          </label>
          <label class="block text-sm font-medium">Telefon <span class="font-normal text-ink-3">(optional)</span>
            <input name="telefon" type="tel" autocomplete="tel" class="mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-base outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
          </label>
          <label class="block text-sm font-medium sm:col-span-2">Was bietest du an? Wer ist dein größter Wettbewerber?
            <textarea name="nachricht" rows="3" class="mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-base outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"></textarea>
          </label>
        </div>
        <button type="submit" class="btn-primary mt-6 w-full">Kostenlose Analyse anfordern</button>
        <p class="mt-3 text-center text-xs text-ink-3">Mit dem Absenden stimmst du der <a href="/datenschutz" class="underline underline-offset-4">Datenschutzerklärung</a> zu. Keine Weitergabe, kein Newsletter.</p>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="container-site py-20 sm:py-28">
