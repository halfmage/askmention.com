---
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-paper-2">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="/" class="font-display text-lg font-bold tracking-tight">Ask<span class="text-accent">Mention</span></a>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-2">
        Smart Website und lokales Suchmarketing für Dienstleister in Deutschland. Sichtbar in Google, Google Maps und KI-Suchen. Ein Ansprechpartner, monatlich kündbar.
      </p>
      <p class="mt-4 text-sm text-ink-3">
        Ein Angebot von <a href={site.ownerSite} class="underline decoration-line underline-offset-4 hover:text-ink">{site.owner} (halfmage)</a>.
      </p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-3">Navigation</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {site.nav.map((n) => <li><a href={`/${n.href}`} class="hover:text-accent">{n.label}</a></li>)}
        <li><a href="/#analyse" class="hover:text-accent">Kostenlose Analyse</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-3">Kontakt &amp; Rechtliches</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={`mailto:${site.email}`} class="hover:text-accent">{site.email}</a></li>
        <li><a href="/impressum" class="hover:text-accent">Impressum</a></li>
        <li><a href="/datenschutz" class="hover:text-accent">Datenschutz</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-site flex flex-col gap-2 py-5 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} AskMention · {site.owner}. Alle Rechte vorbehalten.</p>
      <p>Gebaut mit Astro. Gehostet in der EU.</p>
    </div>
  </div>
</footer>
