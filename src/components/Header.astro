---
import { site } from "../data/site";
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-white">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-5.2-6-11a6 6 0 1 1 12 0c0 5.8-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
      </span>
      <span>Ask<span class="text-accent">Mention</span></span>
    </a>
    <nav class="hidden items-center gap-7 text-sm font-medium text-ink-2 md:flex">
      {site.nav.map((n) => <a href={n.href} class="hover:text-ink">{n.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href="#analyse" class="btn-dark !px-5 !py-2.5 !text-sm whitespace-nowrap"><span class="hidden sm:inline">Kostenlose Analyse</span><span class="sm:hidden">Analyse</span></a>
      <button id="nav-toggle" class="grid h-10 w-10 place-items-center rounded-full border border-line md:hidden" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-nav">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" hidden class="border-t border-line bg-paper md:hidden">
    <div class="container-site flex flex-col py-3 text-base font-medium">
      {site.nav.map((n) => <a href={n.href} class="py-3 border-b border-line/60 last:border-0">{n.label}</a>)}
    </div>
  </nav>
</header>
<script>
  const t = document.getElementById("nav-toggle");
  const m = document.getElementById("mobile-nav");
  t?.addEventListener("click", () => {
    const open = !m!.hidden;
    m!.hidden = open;
    t.setAttribute("aria-expanded", String(!open));
  });
  m?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => { m.hidden = true; t?.setAttribute("aria-expanded", "false"); }));
</script>
